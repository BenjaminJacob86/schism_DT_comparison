# Optional. Phase 1 runs without an ion token (ellipsoid + Esri imagery).
VITE_CESIUM_ION_TOKEN=

# Local now; point at S3/R2 later for tiles and static assets.
VITE_ASSET_BASE_URL=/data

# Optional Cesium 3D Tiles URL. Empty = API proxy (S3 hamburg/area1, then local files).
VITE_BUILDINGS_TILESET_URL=
VITE_BUILDINGS_TILESET_URL=

# Leave empty to use the Vite /api proxy to FastAPI (127.0.0.1:8000).
VITE_API_BASE_URL=

# This repo is the comparison hub (A / B / B−A). start.bat sets this.
VITE_APP_MODE=hub
